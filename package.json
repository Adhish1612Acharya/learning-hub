{
  "name": "learning-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Personal static knowledge base of learnings from books, with slide decks and full-text search.",
  "scripts": {
    "dev": "npm run index && next dev",
    "index": "node scripts/build-index.mjs",
    "slides": "node scripts/generate-slides.mjs",
    "pdf": "node scripts/pptx-to-pdf.mjs",
    "ask": "node scripts/ask.mjs",
    "build": "npm run index && next build",
    "start": "npx serve out"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "minisearch": "^7.2.0",
    "next": "^16.4.3",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pptxgenjs": "^4.0.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
